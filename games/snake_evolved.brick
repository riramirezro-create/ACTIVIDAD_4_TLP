GAME_TYPE SNAKE
GAME_GRID (18, 18)

LEVEL MENU

DEFINE SHAPE PIXEL AS CIRCULAR:
  STATE 1:
    [1]
END

ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
  SPAWN POISON AT RANDOM
  SPAWN CLOUD AT RANDOM
  SPAWN STAR AT RANDOM
END

ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

ON COLLISION_POISON:
  DECREASE_SCORE 5
  SPAWN POISON AT RANDOM
END

ON COLLISION_CLOUD:
  SET_SCORE 0
  SPAWN CLOUD AT RANDOM
END

ON COLLISION_STAR:
  SET_INVULNERABLE
  INCREASE_SCORE 20
  SPAWN STAR AT RANDOM
END

ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END